[Unit]
Description=SPARK studio (site, admin, WhatsApp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spark
Group=spark
WorkingDirectory=/opt/spark
Environment=NODE_ENV=production
Environment=CHROME_PATH=/usr/bin/google-chrome
# Chrome only opens web.whatsapp.com here, as an unprivileged user; Ubuntu blocks its sandbox.
Environment=WA_CHROME_ARGS=--no-sandbox --disable-dev-shm-usage
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
# server.js closes WhatsApp's Chrome on SIGTERM before exiting.
KillSignal=SIGTERM
TimeoutStopSec=20
KillMode=mixed
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
