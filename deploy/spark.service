[Unit]
Description=SPARK studio (site, admin, WhatsApp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spark
Group=spark
WorkingDirectory=/opt/spark
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
# server.js closes the WhatsApp connection on SIGTERM before exiting.
KillSignal=SIGTERM
TimeoutStopSec=20
KillMode=mixed
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
