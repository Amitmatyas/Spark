# GitHub (and Vercel) get only the public landing page and its legal pages.
# The system itself (server, admin, client area, WhatsApp, AI) runs from the NAS and stays there.
/*
!/.gitignore
!/README.md
!/vercel.json
!/public/

/public/*
!/public/index.html
!/public/404.html
!/public/privacy.html
!/public/terms.html
!/public/accessibility.html
!/public/robots.txt
!/public/favicon.ico
!/public/media/
!/public/assets/

/public/assets/*
!/public/assets/base.css
!/public/assets/app.css
!/public/assets/legal.css
!/public/assets/legal.js
!/public/assets/horev.ttf
!/public/assets/icon-192.png
!/public/assets/icon-512.png
!/public/assets/spark-mark.png
!/public/assets/spark-logo-3d.png

.DS_Store
